

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Groq API Key (High-speed Gemma-2 LLM: gemma2-9b-it via LangChain ChatGroq)
# Get your free key at https://console.groq.com
GROQ_API_KEY=

# Hugging Face Access Token (for IndicTrans2 models & HF inference)
# Get token at https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=

# Model Configuration
LLM_MODEL=gemma2-9b-it
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INDICTRANS_INDIC_EN_MODEL=ai4bharat/indictrans2-indic-en-1B
INDICTRANS_EN_INDIC_MODEL=ai4bharat/indictrans2-en-indic-1B

# Optional Telegram & WhatsApp Credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=campus_bot_verify_token

# Storage Paths
DB_PATH=data/campus_bot.db
CIRCULAR_DIR=data/circulars
CHROMA_DIR=data/chromadb
